# =============================================================================
# BISWIC Member Platform - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values. Do NOT commit .env to git.

# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# -----------------------------------------------------------------------------
# Transaction-mode pooler (port 6543) is recommended for serverless Next.js.
# Get this from: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> Transaction pooler.
# The pooler password is ROTATION-SENSITIVE. If you ever paste the connection
# string into a chat, repo, or screenshot, rotate it immediately.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# -----------------------------------------------------------------------------
# Supabase API
# -----------------------------------------------------------------------------
# Project URL: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# anon key:  safe to ship to the browser. Found in Supabase dashboard -> API.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# service_role key:  SERVER ONLY.  Never expose to the browser. Bypasses RLS -
# only use in trusted server code (seed scripts, admin helpers).  Rotated per
# the runbook if ever pasted in a public channel.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="BISWIC"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Seed credentials (dev only -- never used in production)
# -----------------------------------------------------------------------------
# These set the initial password for every account created by prisma:seed.
# In production, change every password on first login.
SEED_OFFICER_PASSWORD="ChangeMe123!"
SEED_MEMBER_PASSWORD="ChangeMe123!"
SEED_EMAIL_DOMAIN="biswic.coop"
